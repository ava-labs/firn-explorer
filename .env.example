# firn API endpoints (one per network). The network switcher in the
# topbar reads these at build time.
#
# Values are same-origin paths that route through the Next.js rewrites
# in next.config.ts to whichever box is hosting the firn instances.
# Set FIRN_BOX_HOST in the environment to point the rewrites elsewhere
# (defaults to the dev box baked into next.config.ts).
NEXT_PUBLIC_FIRN_LOCAL=/api/firn/local
NEXT_PUBLIC_FIRN_TESTNET=/api/firn/fuji
# NEXT_PUBLIC_FIRN_MAINNET=

# Legacy alias kept for any consumer that still reads NEXT_PUBLIC_FIRN_URL
# directly. New code should use the LOCAL/TESTNET/MAINNET split.
NEXT_PUBLIC_FIRN_URL=/api/firn/local

# Override the box that the rewrites in next.config.ts proxy to.
# FIRN_BOX_HOST=100.31.54.139
