# firn API endpoints (one per network). The network switcher in the
# topbar reads these at build time.
#
# Values are same-origin paths routed through Next.js rewrites in
# next.config.ts. By default local points at http://127.0.0.1:4000
# (firn serve / compose). Testnet/mainnet rewrites require FIRN_BOX_HOST.
NEXT_PUBLIC_FIRN_LOCAL=/api/firn/local
NEXT_PUBLIC_FIRN_TESTNET=/api/firn/testnet
# NEXT_PUBLIC_FIRN_MAINNET=/api/firn/mainnet

# Legacy alias kept for any consumer that still reads NEXT_PUBLIC_FIRN_URL
# directly. New code should use the LOCAL/TESTNET/MAINNET split.
NEXT_PUBLIC_FIRN_URL=/api/firn/local

# Optional — legacy remote demo box (DevRel). When set, testnet/mainnet
# rewrites proxy to sslip.io hostnames on the box. Unset for local-only dev.
# FIRN_BOX_HOST=44.195.57.61

# Override the local rewrite target (compose sets FIRN_API_URL at build time).
# FIRN_LOCAL_DEST=http://127.0.0.1:4000
