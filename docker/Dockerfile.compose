# syntax=docker/dockerfile:1.4
# firn-explorer image for the firn compose demo (Phase 0.8).
#
# Build:
#   docker build -f docker/Dockerfile.compose -t firn-explorer:demo .
#
# Published as ghcr.io/ava-labs/firn-explorer by .github/workflows/publish-demo-image.yml

FROM node:22-bookworm AS build

ARG FIRN_API_URL=http://firn:4000

WORKDIR /app
COPY . .
COPY docker/compose-next.config.ts ./next.config.ts

ENV NEXT_PUBLIC_FIRN_LOCAL=/api/firn/local
ENV NEXT_PUBLIC_FIRN_TESTNET=/api/firn/testnet
ENV NEXT_PUBLIC_FIRN_URL=/api/firn/local
ENV FIRN_API_URL=${FIRN_API_URL}
ENV CI=true

RUN rm -rf node_modules .next

RUN corepack enable && \
    pnpm install --frozen-lockfile && \
    pnpm build

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /app/.next ./.next
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/public ./public

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=12 \
  CMD curl -fsS http://127.0.0.1:3000/ >/dev/null

CMD ["npx", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
