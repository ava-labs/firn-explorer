# pre-commit: typecheck first, then lint-staged. Both must pass to
# allow the commit. The typecheck catches cross-file regressions a
# per-file lint won't see; lint-staged runs `eslint --max-warnings=0`
# + `prettier --check` per the package.json config so any warning
# (including new architectural patterns we'd want flagged) blocks
# the commit.
#
# Genuine architectural exceptions (RAF render loops needing refs in
# render, etc.) require an explicit eslint-disable comment with a
# rationale. There is no escape hatch from this hook.
#
# Runs in <15s on a typical edit. If it drifts past 30s, move the
# typecheck to a pre-push hook and keep pre-commit lint-staged-only.

set -e

pnpm exec tsc --noEmit
pnpm exec lint-staged
